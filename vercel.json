{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/r", "destination": "/api/share" }
  ],
  "headers": [
    {
      "source": "/api/og(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=60, s-maxage=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
